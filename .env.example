# =========================================================
# Good Game Arena API — SERVER-SIDE secrets.
# These are set in Vercel (Project → Settings → Environment
# Variables), NOT committed to git and NEVER shipped to the
# browser. This file just documents what to set.
# =========================================================

# Your private Bearer token from Good Game Arena (the value you
# paste into the Swagger "Authorize" box, without the word "Bearer").
GGARENA_TOKEN=paste-your-bearer-token-here

# Optional — only set if your API base URL ever changes.
# GGARENA_BASE=https://www.ggarena.no/api/paradise/v2

# Optional overrides for the ids baked into the api/ functions.
# Team ids, current one FIRST, then any older teams whose matches
# should still count as our history (comma-separated).
# GGARENA_TEAM_IDS=205067,162570
# Current season, used for the league table on the Matches section.
# GGARENA_COMPETITION_ID=13908
# GGARENA_DIVISION_ID=18870

# AI writer (optional). Recaps only cover results from the last N days, so
# the writer can't drift back through old seasons. AI_PREVIEW_DAYS is how
# many days BEFORE kickoff a preview should go out.
# AI_RECAP_DAYS=14
# AI_PREVIEW_DAYS=2
# AI_SEASON_PREVIEW_DAYS=21
# Hours after kickoff during which a match counts as "in progress" and
# previews are held back.
# AI_IN_PROGRESS_HOURS=4
# Articles publish immediately. Set to 0 to go back to drafts you approve.
# AI_AUTOPUBLISH=1

# AI writer model. Defaults to claude-opus-5, which reasons before writing.
# A cheaper option must support adaptive thinking and effort, e.g.
# claude-sonnet-5 (Haiku does not).
# AI_MODEL=claude-opus-5
# How much the writer thinks: low | medium | high | xhigh | max
# AI_EFFORT=high
# Second "sub-editor" pass that fact-checks each article before it goes live.
# Opus 5 checks its own work, so 0 halves cost and time if you trust it.
# AI_FACT_CHECK=1
