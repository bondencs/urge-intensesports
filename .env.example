# =========================================================
# Good Game Arena API — SERVER-SIDE secrets.
# These are set in Vercel (Project → Settings → Environment
# Variables), NOT committed to git and NEVER shipped to the
# browser. This file just documents what to set.
# =========================================================

# Your private Bearer token from Good Game Arena (the value you
# paste into the Swagger "Authorize" box, without the word "Bearer").
GGARENA_TOKEN=paste-your-bearer-token-here

# Optional — only set if your API base URL ever changes.
# GGARENA_BASE=https://www.ggarena.no/api/paradise/v2

# Optional overrides for the ids baked into the api/ functions.
# Team ids, current one FIRST, then any older teams whose matches
# should still count as our history (comma-separated).
# GGARENA_TEAM_IDS=205067,162570
# Current season, used for the league table on the Matches section.
# GGARENA_COMPETITION_ID=13908
# GGARENA_DIVISION_ID=18870
